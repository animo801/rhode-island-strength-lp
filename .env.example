# Meta (Facebook) Pixel ID — Events Manager > Data sources > your pixel
NEXT_PUBLIC_META_PIXEL_ID=299576845408583

# Conversions API access token — Events Manager > your pixel > Settings > Conversions API > Generate access token
META_CAPI_ACCESS_TOKEN=

# Optional: Events Manager > Test events code (e.g. TEST12345). Remove in production.
META_TEST_EVENT_CODE=

# Optional: override the Acuity scheduler URL (defaults to owner=21447693, Clarity Call appointmentType=18913081),
# e.g. for a different appointment type
NEXT_PUBLIC_ACUITY_SCHEDULER_URL=
